{
  "name": "wandering-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.{ts,vue,css}' 'e2e/**/*.ts' '*.json' '*.js' '*.ts' '*.html' '*.yaml'",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "cytoscape": "^3.33.1",
    "dexie": "^4.0.11",
    "maplibre-gl": "^5.6.2",
    "pinia": "^3.0.3",
    "terra-draw": "^1.1.1",
    "terra-draw-maplibre-gl-adapter": "^1.1.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.34.0",
    "eslint-plugin-vue": "^10.4.0",
    "fake-indexeddb": "^6.2.2",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vue-eslint-parser": "^10.2.0",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
